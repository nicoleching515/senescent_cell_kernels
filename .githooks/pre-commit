#!/usr/bin/env bash
# Phase 8 hazard B6 — the section-11 disjointness gate must run after ANY
# gene-set or panel change, not only at freeze time.
#
# `B_oxidative_stress` clears the >=30 floor by one gene on the mouse arm (31),
# and that gene (`Junb`) comes from the 100-gene custom add-on. Under the
# stock-panel-only definition it sits AT the floor. So a commit that touches a
# gene set or a panel file cannot be allowed through without the gate firing.
#
# Installed by:  git -C /workspace config core.hooksPath .githooks
# Bypass (do not, without the PI):  git commit --no-verify
set -u
ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

PY="${SASP_PYTHON:-}"
if [ -z "$PY" ]; then
  # Prefer the project environment; fall back to whatever python3 is on PATH. Both gates are
  # stdlib-only, but preferring the project interpreter means they keep working if either ever
  # grows a numpy dependency.
  if [ -x "$ROOT/envs/sasp311/bin/python" ]; then PY="$ROOT/envs/sasp311/bin/python";
  elif python3 -c "import sys" >/dev/null 2>&1; then PY="python3";
  else PY="python"; fi
fi

# --- section 10: what may never be reported -------------------------------------------------
# Ratchet, not a corpus sweep: a violation already present in HEAD's copy of the same file does
# not block, a violation the commit ADDS does. `check_prohibitions.py --backlog` lists what is
# already there. This is the only mechanical enforcement section 10 has ever had.
if printf '%s\n' "$STAGED" | grep -qE '^(reports/|results/|README\.md$)'; then
  "$PY" "$ROOT/code/check_prohibitions.py" --staged || {
    echo ""
    echo "COMMIT BLOCKED: this commit ADDS a PREREG_PHASE8.md section-10 violation." >&2
    echo "Fix the text, or -- if the paragraph is about the prohibition rather than a report" >&2
    echo "of the number -- say so in the paragraph. See code/check_prohibitions.py --list." >&2
    exit 1
  }
fi

# --- section 11: gene-set disjointness -------------------------------------------------------
if ! printf '%s\n' "$STAGED" | grep -qE '^(genesets/|XeniumPrimeMouse5Kpan_tissue_pathways_metadata\.csv$|GSE310392_Q6VTXC_mMulti_100g_gene_list\.csv\.gz$)'; then
  exit 0
fi

echo "pre-commit: gene sets or a panel file are staged -- running the section-11 gate on both arms."
"$PY" "$ROOT/code/gate_genesets_guard.py" || {
  echo ""
  echo "COMMIT BLOCKED: the section-11 disjointness gate FAILED on the staged gene sets." >&2
  echo "Fix the sets, or re-run 'python3 code/gate_genesets_guard.py' to see which assertion broke." >&2
  exit 1
}
echo "pre-commit: gate PASS."
exit 0
